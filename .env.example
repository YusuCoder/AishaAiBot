# Allegro app credentials (apps.developer.allegro.pl → your app)
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
# Paste the value from "Wygeneruj nagłówek User-Agent" (only the value, without "User-Agent:")
ALLEGRO_USER_AGENT=
# "production" or "sandbox"
ALLEGRO_ENV=production

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your Telegram chat id. Leave empty, start the bot, send /start — it will tell you the id.
TELEGRAM_CHAT_ID=

# Translation (optional). Without a key the bot works without translation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# For gpt-5 models: minimal | low | medium | high. Leave empty for non-reasoning models.
OPENAI_REASONING_EFFORT=low
# Language your team reads and writes in
TEAM_LANGUAGE=Russian
# Shop name used to sign AI-written replies (optional)
SHOP_NAME=

# How often to check Allegro for new messages (seconds)
POLL_INTERVAL_SEC=30
