# Allegro app credentials (apps.developer.allegro.pl → your app)
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
# Paste the value from "Wygeneruj nagłówek User-Agent" (only the value, without "User-Agent:")
ALLEGRO_USER_AGENT=
# "production" or "sandbox"
ALLEGRO_ENV=production

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your Telegram chat id. Leave empty, start the bot, send /start — it will tell you the id.
TELEGRAM_CHAT_ID=

# How often to check Allegro for new messages (seconds)
POLL_INTERVAL_SEC=30
